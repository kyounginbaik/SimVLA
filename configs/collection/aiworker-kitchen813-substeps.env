# Bounded fresh-runtime reference: collection 2436772 -> replay/SimVQA 2437094.
# Extended carry and legacy sink proximity, NOT loaded home or basin containment.
# Bash: source with `set -a`, from a clean environment without other tuning flags.
source "$(dirname -- "${BASH_SOURCE[0]}")/aiworker-kitchen813.env"
SIMVLA_RECORD_JOINT_SUBSTEPS=1
SIMVLA_REPLAY_JOINT_SUBSTEPS=1
SIMVLA_REPLAY_ADAPTIVE_GRIPPER=1
SIMVLA_REPLAY_INITIAL_JOINT_STATE=1
SIMVLA_REPLAY_EPISODE_INDEX=0
# At most 5 extra seconds at 20 Hz. Reference used 18 steps (0.9 seconds).
# This is NOT replay within the recording's original time boundary.
SIMVLA_REPLAY_SETTLE_STEPS=100
