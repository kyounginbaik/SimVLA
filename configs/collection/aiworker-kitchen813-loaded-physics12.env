# Experimental finer-physics profile; independent replay validation is pending.
# Based on the nominal, actual loaded-home and repaired-basin recipe.
# Source from a clean shell with `set -a` and provide runtime/assets separately.
source "$(dirname -- "${BASH_SOURCE[0]}")/aiworker-kitchen813-loaded-prelude.env"
SIMVLA_PHYSICS_SUBSTEPS=12
SIMVLA_GRIPPER_BALANCE_STEP_FRACTION=.0025
SIMVLA_MAXFRAMES=6500
SIMVLA_EPISODE_STEPS=5500
SIMVLA_REPLAY_JOINT_TARGETS=1
SIMVLA_REPLAY_ADAPTIVE_GRIPPER=1
SIMVLA_REPLAY_INITIAL_JOINT_STATE=1
SIMVLA_REPLAY_BASE_TRACKING=1
SIMVLA_REPLAY_SETTLE_STEPS=100
SIMVLA_SIMVQA=1
