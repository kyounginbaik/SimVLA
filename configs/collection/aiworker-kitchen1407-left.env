# Tested one-seed AI Worker left-hand mug-to-table profile (kitchen 1407).
# Source with `set -a; . configs/collection/aiworker-kitchen1407-left.env; set +a`.
# Runtime, asset paths, and SIMVLA_SOURCE_GOAL remain caller supplied.
ROBOT=aiworker
SIMVLA_TASK=Isaac-Kitchen-v1407a-00
SIMVLA_COLLECT_ARM=left
SIMVLA_GRASP_CANDIDATE_INDEX=0
SIMVLA_GRASP_GEOMETRY=cylindrical_mug
SIMVLA_AIWORKER_SEGMENTED_GRASP_STANDOFF_M=0.10
SIMVLA_AIWORKER_LIFT_M=-0.35
SIMVLA_MUG_LIVE_Z_TRACK=1
SIMVLA_POSTRELEASE_RETREAT_M=0.12
SIMVLA_POSTRELEASE_RETREAT_LIFT_M=-0.03
SIMVLA_POSTRELEASE_FINAL_HOME=1
SIMVLA_AIWORKER_FINAL_HOME_JOINT_TARGETS=1
SIMVLA_FIXED_OBJECT=0
SIMVLA_SEED=0
SIMVLA_MAXFRAMES=3200
SIMVLA_REPLAY_JOINT_TARGETS=1
SIMVLA_REPLAY_INITIAL_JOINT_STATE=1
SIMVLA_REPLAY_INITIAL_STEP=1
SIMVLA_REPLAY_BASE_TRACKING=1
SIMVLA_SIMVQA=1
