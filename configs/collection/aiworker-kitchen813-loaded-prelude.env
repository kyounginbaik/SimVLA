# Experimental current-recorder profile; physical replay validation is required.
# Actual loaded home and repaired basin, with nominal (not perturbed) goal targets.
# Initial spawn/camera/light variation is separate. Requires new initial_step metadata.
source "$(dirname -- "${BASH_SOURCE[0]}")/aiworker-kitchen813-loaded-basin.env"
SIMVLA_GOAL_NAV_XY_STD_M=0
SIMVLA_GOAL_NAV_YAW_STD_RAD=0
SIMVLA_GOAL_ARM_XYZ_STD_M=0
SIMVLA_REPLAY_INITIAL_STEP=1
