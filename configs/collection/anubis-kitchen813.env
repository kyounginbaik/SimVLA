# One-scene reference, validated by collection 2411130 and replay 2412901.
# Replay uses recorded joint motor targets and bounded base-pose feedback.
# Source this with `set -a`; supply runtime/assets/output paths separately.
# Prepare SIMVLA_SOURCE_GOAL with make_anubis_drawer_diagnostic.py:
# --lateral-shift-m .17 --backoff-m .05 --swap-drawer-jaws --with-metadata
ROBOT=anubis
SIMVLA_SEED=0
SIMVLA_REPLAY_BASE_TRACKING=1
SIMVLA_REPLAY_JOINT_TARGETS=1
SIMVLA_GRASP_CANDIDATE_INDEX=10
SIMVLA_FIXED_OBJECT=1
SIMVLA_REQUIRE_CUROBO_PLAN=0
SIMVLA_GRIPPER_FORCE_BALANCE=0
SIMVLA_CUROBO_WORLD=live
SIMVLA_CUROBO_TARGET_COLLISION=exclude
SIMVLA_PREGRASP_STANDOFF=0
SIMVLA_RESET_ROT_TOL_DEG=10
SIMVLA_PHYSICS_SUBSTEPS=6
SIMVLA_PLANNER_ATTEMPTS=2
SIMVLA_GRAPH_SEEDS=4
SIMVLA_TRAJOPT_SEEDS=4
SIMVLA_FINETUNE_TRAJOPT=1
SIMVLA_NAV_FINAL_YAW=0.02
SIMVLA_MAXFRAMES=10000
SIMVLA_EPISODE_STEPS=5000
SIMVLA_REVIEW_CAMERA=front
SIMVLA_REVIEW_EVERY=1
