# Experimental: collection 2437355 exported three episodes; only one of three
# independent action-only replays passed. Not a validated bulk-replay profile.
# Use a separately generated goal with parking advance .15 and EEF [1.83,-2.20,1.08].
# Nominal targets, not randomized robustness. Scene/spawn randomness is separate.
source "$(dirname -- "${BASH_SOURCE[0]}")/rby1-kitchen813-basin.env"
SIMVLA_GOAL_NAV_XY_STD_M=0
SIMVLA_GOAL_NAV_YAW_STD_RAD=0
SIMVLA_GOAL_ARM_XYZ_STD_M=0
SIMVLA_NUM_DEMOS=3
SIMVLA_MAXFRAMES=8500
