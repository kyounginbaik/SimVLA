+def compare_element(x, y):
+    if isinstance(x, dict):
+        if not isinstance(y, dict):
+            return False, x, y
+        for k in x.keys():
+            if k not in y:
+                return False, x, y 
+            retf, ret1, ret2 = compare_element(x[k], y[k])
+            if not retf:
+                return False, x[k], y[k]  
+        return True, None, None 
+    elif x != y:
+        return False, x, y 
+    else:
+        return True, None, None 
